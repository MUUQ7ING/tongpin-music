[Unit]
Description=Tongpin music platform
After=network.target

[Service]
User=musicapp
Group=musicapp
WorkingDirectory=/opt/music-platform/current
ExecStart=/opt/music-platform/venv/bin/gunicorn --workers 2 --threads 2 --bind 127.0.0.1:5001 --timeout 120 --access-logfile - --error-logfile - run:app
Restart=on-failure
RestartSec=5
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/music-platform/media

[Install]
WantedBy=multi-user.target
