[Unit]
Description=Restrict openGauss client port to local connections
After=network.target
Before=music-platform.service
[Service]
Type=oneshot
ExecStart=/bin/sh -c '/usr/sbin/iptables -C INPUT ! -i lo -p tcp --dport 26000 -j REJECT 2>/dev/null || /usr/sbin/iptables -I INPUT ! -i lo -p tcp --dport 26000 -j REJECT'
RemainAfterExit=yes
[Install]
WantedBy=multi-user.target
